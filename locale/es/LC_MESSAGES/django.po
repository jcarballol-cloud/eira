msgstr "Para saber cuántas personas usan la instalación y, si quieres, quién."

#: apps/accounts/custody.py:124
msgid "Os da reserva (2 anos)."
msgstr "Los de la reserva (2 años)."

#: apps/accounts/custody.py:128
msgid ""
"Para que, se algo xa estaba mal, non se che atribúa e se poida reparar."
msgstr ""
"Para que, si algo ya estaba mal, no se te atribuya y se pueda reparar."

#: apps/accounts/custody.py:129
msgid "Os da reserva; se se creou unha incidencia, os da incidencia (2 anos)."
msgstr ""
"Los de la reserva; si se creó una incidencia, los de la incidencia (2 años)."

#: apps/accounts/custody.py:133
msgid "Para descontar os usos das túas reservas."
msgstr "Para descontar los usos de tus reservas."

#: apps/accounts/custody.py:134
