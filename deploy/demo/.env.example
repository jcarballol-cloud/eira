# Copia a .env (nunca se sobe ao repositorio) e enche os baleiros. Xera cada segredo con:
#   python3 -c "import secrets;print(secrets.token_urlsafe(50))"
EIRA_DOMAIN=eira.engramlab.es
EIRA_SECRET_KEY=
EIRA_TOTP_KEY=
POSTGRES_PASSWORD=
# Só detrás doutro proxy (docker-compose.tras-proxy.yml): rede de Docker dese proxy
EIRA_PROXY_NETWORK=engram-gestor_default
# Opcionais
# EIRA_RESEED_HOUR=4            # hora de Madrid da rexeneración nocturna
# HTTP_PORT=18080               # só para probas locais, se 80 e 443 están ocupados
# HTTPS_PORT=18443
# EIRA_ORIGIN_PORT=:18443       # só nas probas locais: o porto, para a orixe de CSRF
