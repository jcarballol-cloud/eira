# SPDX-License-Identifier: EUPL-1.2
# Copia este ficheiro a .env e axusta os valores. Nunca subas .env ao repositorio.
EIRA_DEBUG=1
# En produción: xera unha chave longa e aleatoria (python -c "import secrets;print(secrets.token_urlsafe(50))")
EIRA_SECRET_KEY=
EIRA_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
EIRA_BASE_DOMAIN=localhost
EIRA_DEMO_TOOLS=1
# PostgreSQL (docker compose) ou SQLite en local
DATABASE_URL=postgres://eira:eira@db:5432/eira
# DATABASE_URL=sqlite:///db.sqlite3
EIRA_SECURE_COOKIES=0
# Teselas do mapa (pode ser un servidor propio do concello ou da deputación)
EIRA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EIRA_TILE_ORIGIN=https://tile.openstreetmap.org
# Adaptadores (todos simulados por defecto)
# EIRA_MAIL_ADAPTER=apps.integrations.mail.SmtpMailAdapter
# EIRA_AI_ADAPTER=apps.integrations.ai.OpenAICompatibleAdapter
# EIRA_AI_BASE_URL=http://localhost:11434/v1
# EIRA_AI_MODEL=llama3.1
EIRA_MIN_AGGREGATION=10
# Telegram (avisos). Deixa o token baleiro: ponse só no contorno do servidor, nunca aquí.
# EIRA_TELEGRAM_ADAPTER=apps.integrations.telegram.BotApiTelegramAdapter
# EIRA_TELEGRAM_TOKEN=
# EIRA_TELEGRAM_BOT=nome_do_bot
# EIRA_TELEGRAM_WEBHOOK_SECRET=
