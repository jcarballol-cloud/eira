# HTTPS automático (Let's Encrypt, gratuíto). Só os ficheiros públicos se serven directamente;
# as fotos de incidencias e ordes pasan pola aplicación, que comproba permisos.
{
	email {$ACME_EMAIL}
}

{$EIRA_DOMAIN} {
	encode zstd gzip

	@public_media path /media/facilities/* /media/tenants/*
	handle @public_media {
		uri strip_prefix /media
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy app:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header {
		-Server
		X-Robots-Tag "noindex"  # demo: non indexar
	}
	log
}
